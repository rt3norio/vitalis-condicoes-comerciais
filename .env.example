# Modelo por agente (slug do OpenRouter). Por enquanto GLM nos três.
MODEL_EXTRATOR=z-ai/glm-5.3
MODEL_VERIFICADOR=z-ai/glm-5.3
MODEL_REDATOR=z-ai/glm-5.3

# Neon Postgres (Vercel Marketplace). Preenchido quando o banco for criado.
DATABASE_URL=
