# Copie para .env.local e preencha. Nunca commitar .env.local.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Modelo por agente (slug do OpenRouter). GLM-5.3 nos três, escolhido por teste (docs/entrega-pdf.md, seção 05).
MODEL_EXTRATOR=z-ai/glm-5.3
MODEL_VERIFICADOR=z-ai/glm-5.3
MODEL_REDATOR=z-ai/glm-5.3

# SQLite (libsql). Vazio = .data/app.db. No Fly: file:/data/app.db (volume, ver fly.toml).
DATABASE_URL=
